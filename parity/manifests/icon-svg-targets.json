{
  "version": 1,
  "description": "Capture targets for Circular + Linear icon/SVG parity snapshots.",
  "targets": [
    {
      "id": "home-shell-sweep",
      "mode": "sweep",
      "route": "/",
      "maxSvg": 180,
      "description": "Home shell icon sweep"
    },
    {
      "id": "team-issues-sweep",
      "mode": "sweep",
      "circular": {
        "route": "/team/{TEAM_KEY}/issues"
      },
      "linear": {
        "route": "/team/{TEAM_KEY}/all"
      },
      "maxSvg": 220,
      "description": "Main team issues list icon sweep"
    },
    {
      "id": "my-issues-assigned-sweep",
      "mode": "sweep",
      "circular": {
        "route": "/my-issues?view=assigned"
      },
      "linear": {
        "route": "/my-issues/assigned"
      },
      "maxSvg": 200,
      "description": "My issues assigned view icon sweep"
    },
    {
      "id": "my-issues-created-sweep",
      "mode": "sweep",
      "circular": {
        "route": "/my-issues?view=created"
      },
      "linear": {
        "route": "/my-issues/created"
      },
      "maxSvg": 200,
      "description": "My issues created view icon sweep"
    },
    {
      "id": "my-issues-subscribed-sweep",
      "mode": "sweep",
      "circular": {
        "route": "/my-issues?view=subscribed"
      },
      "linear": {
        "route": "/my-issues/subscribed"
      },
      "maxSvg": 200,
      "description": "My issues subscribed view icon sweep"
    },
    {
      "id": "inbox-sweep",
      "mode": "sweep",
      "route": "/inbox",
      "maxSvg": 180,
      "description": "Inbox icon sweep"
    },
    {
      "id": "projects-sweep",
      "mode": "sweep",
      "route": "/projects",
      "maxSvg": 180,
      "description": "Projects index icon sweep"
    },
    {
      "id": "views-sweep",
      "mode": "sweep",
      "route": "/views",
      "maxSvg": 180,
      "description": "Views index icon sweep"
    },
    {
      "id": "team-views-sweep",
      "mode": "sweep",
      "route": "/team/{TEAM_KEY}/views",
      "maxSvg": 220,
      "description": "Team views icon sweep"
    },
    {
      "id": "team-projects-sweep",
      "mode": "sweep",
      "route": "/team/{TEAM_KEY}/projects",
      "maxSvg": 220,
      "description": "Team projects icon sweep"
    },
    {
      "id": "team-cycles-sweep",
      "mode": "sweep",
      "route": "/team/{TEAM_KEY}/cycles",
      "maxSvg": 220,
      "description": "Team cycles icon sweep"
    },
    {
      "id": "initiatives-sweep",
      "mode": "sweep",
      "route": "/initiatives",
      "maxSvg": 220,
      "description": "Initiatives icon sweep"
    },
    {
      "id": "team-active-sweep",
      "mode": "sweep",
      "route": "/team/{TEAM_KEY}/active",
      "maxSvg": 220,
      "description": "Team active board icon sweep"
    },
    {
      "id": "team-backlog-sweep",
      "mode": "sweep",
      "route": "/team/{TEAM_KEY}/backlog",
      "maxSvg": 220,
      "description": "Team backlog icon sweep"
    },
    {
      "id": "sidebar-home-icon",
      "requiresAuth": true,
      "route": "/",
      "selector": [
        "aside nav a[href='/']",
        "a[href='/']",
        "[role='button']:has-text('Home')",
        "button[aria-label*='Home']"
      ],
      "linear": {
        "selector": [
          "aside nav button[aria-label*='Workspace Menu']",
          "button[aria-label*='Workspace Menu']",
          "aside nav a[href*='/pulse/']",
          "a[href*='/pulse/']",
          "aside nav a[href*='/my-issues/assigned']"
        ]
      },
      "svgSelector": [
        "svg",
        "self"
      ],
      "description": "Home navigation icon"
    },
    {
      "id": "new-issue-button-icon",
      "requiresAuth": true,
      "circular": {
        "route": "/team/{TEAM_KEY}/issues",
        "selector": [
          "button:has-text('New issue')",
          "button:has-text('Create issue')",
          "button[aria-label*='Create new issue']",
          "button[aria-label*='New issue']",
          "button[aria-label*='Create issue']"
        ]
      },
      "linear": {
        "route": "/team/{TEAM_KEY}/all",
        "selector": [
          "button:has-text('New issue')",
          "button:has-text('Create issue')",
          "button[aria-label*='Create new issue']",
          "button[aria-label*='New issue']",
          "button[aria-label*='Create issue']",
          "button[aria-label*='New Issue']",
          "button[aria-label*='Create Issue']",
          "[data-testid*='new-issue']",
          "[data-testid*='create-issue']",
          "[data-testid*='newIssue']",
          "[data-testid*='createIssue']",
          "button:has-text('New')",
          "button:has-text('Create')"
        ]
      },
      "svgSelector": "svg",
      "description": "Create/new issue button icon"
    },
    {
      "id": "filter-button-icon",
      "requiresAuth": true,
      "circular": {
        "route": "/team/{TEAM_KEY}/issues",
        "selector": [
          "button:has-text('Filter')",
          "button:has-text('Add filter')",
          "button[aria-label*='Filter']",
          "button[aria-label*='filter']"
        ]
      },
      "linear": {
        "route": "/team/{TEAM_KEY}/all",
        "selector": [
          "button:has-text('Filter')",
          "button:has-text('Add filter')",
          "button[aria-label*='Filter']",
          "button[aria-label*='filter']"
        ]
      },
      "svgSelector": "svg",
      "description": "Filter button icon"
    }
  ]
}
